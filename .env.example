# Copy to .env and fill in. Values here seed the database on first run.
PORT=3000

# ABDM sandbox bridge credentials (get these from your ABDM sandbox registration)
ABDM_CLIENT_ID=your_client_id
ABDM_CLIENT_SECRET=your_client_secret

# Gateway base + relative paths (adjust if the sandbox version changes)
ABDM_GATEWAY_BASE=https://dev.abdm.gov.in/gateway
ABDM_SESSION_PATH=/v0.5/sessions
ABDM_X_CM_ID=sbx
ABDM_ABHA_BASE=https://abhasbx.abdm.gov.in/abha/api/v3

# Your bridge's public HTTPS URL (e.g. an ngrok/cloudflared tunnel to this app)
ABDM_BRIDGE_URL=
